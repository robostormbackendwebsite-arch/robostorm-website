# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# GOOGLE FIREBASE CLOUD FIRESTORE CREDENTIALS
# ========================================================
# Option A (Recommended): Place the downloaded Service Account Key JSON in root folder
# and set its filename here:
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# Option B: Or provide individual environment variables:
# FIREBASE_PROJECT_ID="robostorms-official"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@robostorms-official.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

